{
    "profiles": [{
            "name": "Default profile",
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
            "description": "# __#__~/.config/karabiner/karabiner.json__#__"
        },
        {
            "complex_modifications": {
                "rules": [{
                    "description": "Map Menu Key (Right Click) to Left Option",
                    "manipulators": [{
                        "from": { "key_code": "menu" },
                        "to": [{ "key_code": "left_option" }],
                        "type": "basic"
                    }]
                }]
            },
            "devices": [{
                "identifiers": {
                    "is_keyboard": true,
                    "product_id": 49978,
                    "vendor_id": 1133
                },
                "simple_modifications": [{
                        "from": { "key_code": "application" },
                        "to": [{ "key_code": "left_option" }]
                    },
                    {
                        "from": { "key_code": "left_command" },
                        "to": [{ "key_code": "right_command" }]
                    },
                    {
                        "from": { "key_code": "left_option" },
                        "to": [{ "key_code": "left_command" }]
                    },
                    {
                        "from": { "key_code": "right_option" },
                        "to": [{ "key_code": "left_command" }]
                    }
                ]
            }],
            "name": "Citrix  - Windows from Mac",
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        },
        {
            "complex_modifications": {
                "rules": [{
                        "description": "Remap Ctrl + Home/End to Cmd + Up/Down Arrow (with Ctrl remapped to Cmd)",
                        "manipulators": [{
                                "from": {
                                    "key_code": "home",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [{
                                    "key_code": "up_arrow",
                                    "modifiers": ["left_command"]
                                }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "home",
                                    "modifiers": { "mandatory": ["left_command", "shift"] }
                                },
                                "to": [{
                                    "key_code": "up_arrow",
                                    "modifiers": ["left_command", "shift"]
                                }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "end",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [{
                                    "key_code": "down_arrow",
                                    "modifiers": ["left_command"]
                                }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "end",
                                    "modifiers": { "mandatory": ["left_command", "shift"] }
                                },
                                "to": [{
                                    "key_code": "down_arrow",
                                    "modifiers": ["left_command", "shift"]
                                }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap Cmd + Left/Right Arrow to move/select word left/right",
                        "manipulators": [{
                                "from": {
                                    "key_code": "left_arrow",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [{
                                    "key_code": "left_arrow",
                                    "modifiers": ["left_option"]
                                }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "left_arrow",
                                    "modifiers": { "mandatory": ["left_command", "shift"] }
                                },
                                "to": [{
                                    "key_code": "left_arrow",
                                    "modifiers": ["left_option", "shift"]
                                }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "right_arrow",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [{
                                    "key_code": "right_arrow",
                                    "modifiers": ["left_option"]
                                }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "right_arrow",
                                    "modifiers": { "mandatory": ["left_command", "shift"] }
                                },
                                "to": [{
                                    "key_code": "right_arrow",
                                    "modifiers": ["left_option", "shift"]
                                }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap Opt+Tab to Cmd+Tab for window switching",
                        "manipulators": [{
                            "from": {
                                "key_code": "tab",
                                "modifiers": { "mandatory": ["left_option"] }
                            },
                            "to": [{
                                "key_code": "tab",
                                "modifiers": ["left_command"]
                            }],
                            "type": "basic"
                        }]
                    },
                    {
                        "description": "Remap Cmd+Tab to Ctrl+Tab for browser tab switching",
                        "manipulators": [{
                            "from": {
                                "key_code": "tab",
                                "modifiers": { "mandatory": ["left_command"] }
                            },
                            "to": [{
                                "key_code": "tab",
                                "modifiers": ["left_control"]
                            }],
                            "type": "basic"
                        }]
                    }
                ]
            },
            "devices": [{
                "identifiers": {
                    "is_keyboard": true,
                    "product_id": 49978,
                    "vendor_id": 1133
                },
                "simple_modifications": [{
                        "from": { "key_code": "left_command" },
                        "to": [{ "key_code": "left_control" }]
                    },
                    {
                        "from": { "key_code": "left_control" },
                        "to": [{ "key_code": "left_command" }]
                    },
                    {
                        "from": { "key_code": "right_control" },
                        "to": [{ "key_code": "right_command" }]
                    }
                ]
            }],
            "name": "Windows like on mac",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}